VIRTUALS_WALLET_ADDRESS=
# Privy EVM wallet ID from the Virtuals agent Signers tab.
VIRTUALS_WALLET_ID=
# Base64 PKCS#8 P-256 authorization key from the Virtuals agent Signers tab (starts MIGH); never use an EOA key.
VIRTUALS_SIGNER_PRIVATE_KEY=
# Use development for an agent created at app-dev.virtuals.io; use production for app.virtuals.io.
VIRTUALS_NETWORK=development
SENTINEL_DASHBOARD=https://sentinel-security-one.vercel.app
SENTINEL_WORKER_TOKEN=
